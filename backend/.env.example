# AURA Backend – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to source control.

# ── Roboflow ──────────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PROJECT_ID=flood-detection
ROBOFLOW_MODEL_VERSION=1
ROBOFLOW_CONFIDENCE_THRESHOLD=0.40

# ── YOLO ──────────────────────────────────────────────────
# Use the lightweight nano model by default
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# ── Security ──────────────────────────────────────────────
# Set a strong secret key in production
SECRET_KEY=change_me_in_production
